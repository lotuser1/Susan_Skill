# ↓↓↓ 复制本文件为 config.env 并按需修改（config.env 已被 .gitignore 忽略，不会上传） ↓↓↓
# 注意：等号两边不要有空格，值用双引号包住

# 【可选】知识库根目录（下载的文稿落到这里的 00 待分类/<账户>/）
KB_ROOT="/Users/songzi/Documents/知识库"

# 【必填】Chrome 远程调试端口：先运行 start_chrome.sh 启动带调试端口的 Chrome 并扫码登录
TINGWU_CHROME_PORT=9222

# 【可选】列表接口每页条数（默认 200）
# TW_PAGE_SIZE=200

# 【可选】单条最多尝试次数，超过判定顽固失败并跳过（默认 3）
# TW_MAX_ATTEMPTS=3

# 【可选】显式指定 Chrome 可执行文件路径（自动探测失败时填这里）
# CHROME_BIN="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
